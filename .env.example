# Supabase project (Vercel → Storage → Supabase injects NEXT_PUBLIC_* automatically).
# For local development copy this file to .env.local and fill in your values.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only for the load-test script (never ship to the browser):
# LOADTEST_EVENT_CODE=HEXA26
# LOADTEST_HOST_SECRET=...
